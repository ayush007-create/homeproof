# Copy to .env and fill in. Never commit .env.

# ---- Required ----
# Signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Google AI Studio key for Gemini (not needed when MOCK_SCAN=1).
GEMINI_API_KEY=

# ---- Database (recommended) ----
# MongoDB Atlas connection string. Without it, data is kept in memory and lost on restart.
MONGODB_URI=

# ---- Gemini models (optional) ----
# Defaults: gemini-flash-latest, backup gemini-flash-lite-latest. Run `npm run models` to see names.
GEMINI_MODEL=
# Comma-separated backup models, tried in order.
GEMINI_FALLBACK_MODELS=
# Time each model gets before we move to the backup (ms). Default 20000.
MODEL_TIMEOUT_MS=
# Time the whole scan gets before giving up (ms). Default 60000.
SCAN_TIMEOUT_MS=

# ---- Claude backup scanner (optional) ----
# Anthropic key. Used only when every Gemini model fails. Without it, there is no Claude backup.
ANTHROPIC_API_KEY=
# Optional Claude model. Default: claude-haiku-4-5 (fast, good with photos).
ANTHROPIC_MODEL=

# ---- Voice (optional) ----
# ElevenLabs key. Without it, the app has no voice.
ELEVENLABS_API_KEY=
# Optional voice ID. Default: a premade ElevenLabs voice.
ELEVENLABS_VOICE_ID=
# Optional speaking pace, 0.7 (slowest) to 1.2. Default 0.85 (a little slower than normal).
ELEVENLABS_SPEED=

# ---- Home location (optional) ----
# Recording only unlocks within this distance of the home (meters). Default 150.
HOME_RADIUS_M=
# 0 = switch the location check off (only for local testing, e.g. the Miami demo home from elsewhere).
REQUIRE_LOCATION=
# Your email or site, sent to OpenStreetMap's address lookup as its usage policy asks.
GEOCODER_CONTACT=
# Another Nominatim server, if you run your own. Default https://nominatim.openstreetmap.org
NOMINATIM_URL=

# ---- Server ----
# Frontend URL(s) allowed to call the API with cookies, comma-separated. Leave empty in development.
CLIENT_ORIGIN=
# 1 = fake items, no Gemini calls (for UI work).
MOCK_SCAN=
PORT=3001
